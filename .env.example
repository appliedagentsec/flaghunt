# Copy to .env and fill in only what you use. .env is git-ignored.
# Keys stay on your machine: the harness calls the model API from the host,
# and the sandbox (where commands run) never sees them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ollama on another host or port (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Use podman instead of docker
# FLAGHUNT_CONTAINER_ENGINE=podman
